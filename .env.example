# VoiceOps Environment Configuration

# Rime API Credentials (REQUIRED for live voice synthesis)
# Get your API key from Rime dashboard: https://rime.ai / https://users.rime.ai
RIME_API_KEY=your_rime_api_key_here

# Rime Speech Configuration
# Models: "coda" (flagship expressive) or "mistv3" / "mist" (ultra-low latency)
RIME_MODEL=coda

# Speakers: "astra", "luna", "marcus", "zeus", "eva", "marina"
RIME_SPEAKER=astra

# Default Language
RIME_LANG=en

# Rime API Endpoint
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# Audio Format: "audio/mpeg" (mp3) or "audio/wav"
RIME_AUDIO_FORMAT=audio/mpeg

# Server Ports
PORT=8000
HOST=0.0.0.0
